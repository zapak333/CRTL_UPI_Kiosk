# ---------- Server ----------
NODE_ENV=production
PORT=8080
# Public URL of this server (used for webhook URL hints and links)
PUBLIC_URL=http://localhost:8080
# Long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me-to-a-long-random-string
# Set to true when the app is served over HTTPS (secure cookies)
COOKIE_SECURE=false
# Optional: comma-separated IPs allowed to reach /admin and /api/admin (empty = any)
ADMIN_ALLOWED_IPS=
# Optional: one-time token for the first-admin setup page. If empty, one is generated and printed in the server log.
ADMIN_SETUP_TOKEN=

# ---------- Database ----------
DATABASE_URL=postgres://crtl:crtl_dev@localhost:5432/crtl_kiosk

# ---------- Payments ----------
# simulated | razorpay
PAYMENT_PROVIDER=simulated
# Secret used to sign simulated webhooks (simulated mode only)
SIMULATED_WEBHOOK_SECRET=sim-secret-change-me
# Razorpay (use TEST keys until formal testing is complete)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Minutes a UPI QR stays valid
PAYMENT_QR_TTL_MINUTES=5

# ---------- Storage ----------
DATA_DIR=./data
BACKUP_DIR=./data/backups
BACKUP_KEEP_DAYS=30
# Daily backup time (cron, IST)
BACKUP_CRON=30 23 * * *
